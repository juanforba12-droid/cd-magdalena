+function etiquetasLinea(n, tipo) {
+  const tablas = {
+    defensa:  { 3: ["DFI","DFC","DFD"], 4: ["LI","DFC","DFC","LD"], 5: ["LI","DFC","DFC","DFC","LD"] },
+    ataque:   { 1: ["DC"], 2: ["DC","DC"], 3: ["EI","DC","ED"], 4: ["EI","DC","DC","ED"] },
+    medioDef: { 1: ["MCD"], 2: ["MCD","MCD"], 3: ["MCD","MCD","MCD"] },
+    medioOfe: { 1: ["MP"], 2: ["MP","MP"], 3: ["MI","MP","MD"] },
+    medio:    { 1: ["MC"], 2: ["MC","MC"], 3: ["MI","MC","MD"], 4: ["MI","MC","MC","MD"], 5: ["MI","MCI","MC","MCD","MD"] },
+  };
+  const tabla = tablas[tipo] || tablas.medio;
+  return tabla[n] || tablas.medio[n] || Array.from({ length: n }, (_, i) => `${tipo.slice(0, 2).toUpperCase()}${i + 1}`);
+}
+
+function construirFormacion(lineas) {
+  const numLineas = lineas.length;
+  const slots = [{ id: "por", label: "POR", top: 92, left: 50 }];
+  lineas.forEach((n, li) => {
+    let tipo = "medio";
+    if (li === 0) tipo = "defensa";
+    else if (li === numLineas - 1) tipo = "ataque";
+    else if (numLineas > 3 && li === 1) tipo = "medioDef";
+    else if (numLineas > 3 && li === numLineas - 2) tipo = "medioOfe";
+    const etiquetas = etiquetasLinea(n, tipo);
+    const top = numLineas === 1 ? 45 : Math.round(80 - (li / (numLineas - 1)) * 68);
+    for (let i = 0; i < n; i++) {
+      const left = n === 1 ? 50 : Math.round(10 + (i + 0.5) * (80 / n));
+      slots.push({ id: `l${li}_${i}`, label: etiquetas[i] || tipo.toUpperCase(), top, left });
+    }
+  });
+  return slots;
+}
+
+const FORMACIONES = Object.fromEntries(
+  Object.entries(SISTEMAS_LINEAS).map(([nombre, lineas]) => [nombre, construirFormacion(lineas)])
+);
